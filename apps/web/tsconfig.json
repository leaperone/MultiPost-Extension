{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node", "vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "collections/*": ["./.source/*"],
      "@/prisma/*": ["../../prisma/*"],
      "@/src/*": ["./src/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "store/**/*.ts",
    "store/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    ".source/**/*.ts",
    "hero.ts",
    "source.config.ts",
    "vite.config.ts",
    "*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
