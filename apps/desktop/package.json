{
  "name": "multipost-desktop",
  "version": "0.2.3",
  "description": "MultiPost Desktop - Social Media Multi-Platform Publishing",
  "main": "./out/main/index.js",
  "author": "MultiPost Team",
  "license": "MIT",
  "homepage": "https://multipost.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/leaperone/MultiPost.git",
    "directory": "apps/desktop"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "verify:injectors": "node scripts/verify-injector-bundles.mjs",
    "typecheck:main": "tsc --noEmit -p src/main/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p src/renderer/tsconfig.json",
    "typecheck": "pnpm typecheck:main && pnpm typecheck:renderer && pnpm verify:injectors",
    "release": "./scripts/release-hybrid.sh"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@heroui/react": "^2.8.7",
    "@heroui/theme": "^2.4.25",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.563.0",
    "marked": "^18.0.5",
    "next-themes": "^0.4.6",
    "proxy-chain": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {}
}
