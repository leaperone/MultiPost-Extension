# ============================================================
# 本地开发环境变量（可选，仅本地构建/调试时使用）
# CI 发布流程使用 GitHub Secrets，无需本地配置
# ============================================================

# Apple 签名（本地手动构建时使用）
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=5UAHRS482C

# Bitiful S3（本地手动上传时使用）
BITIFUL_ACCESS_KEY_ID=
BITIFUL_SECRET_ACCESS_KEY=
BITIFUL_BUCKET=2someone-web-static
BITIFUL_ENDPOINT=https://s3.bitiful.net
BITIFUL_REGION=cn-east-1

# ============================================================
# GitHub Secrets 配置清单（Release 仓库需要配置）
# Repository: leaperone/MultiPost-Desktop-Release
# ============================================================
#
# PRIVATE_REPO_PAT          - 访问私有主仓库的 PAT
# CSC_LINK                  - macOS 签名证书 (.p12 base64 编码)
# CSC_KEY_PASSWORD           - 证书密码
# APPLE_ID                  - Apple ID 邮箱
# APPLE_APP_SPECIFIC_PASSWORD - Apple 应用专用密码
# APPLE_TEAM_ID             - Apple 开发者团队 ID (5UAHRS482C)
# BITIFUL_ACCESS_KEY_ID     - S3 Access Key
# BITIFUL_SECRET_ACCESS_KEY - S3 Secret Key
#
# 主仓库 (leaperone/MultiPost-Desktop):
# RELEASE_REPO_PAT          - 触发 Release 仓库 workflow 的 PAT
