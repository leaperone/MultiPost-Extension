{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "../../out/main",
    "rootDir": "../../../",
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./*"],
      "@shared/*": ["../shared/*"],
      "@ext/sync/article/bilibili": ["./injectors/ext-shims/sync/article/bilibili.d.ts"],
      "@ext/sync/article/weibo": ["./injectors/ext-shims/sync/article/weibo.d.ts"],
      "@ext/sync/article/zhihu": ["./injectors/ext-shims/sync/article/zhihu.d.ts"],
      "@ext/sync/dynamic/bilibili": ["./injectors/ext-shims/sync/dynamic/bilibili.d.ts"],
      "@ext/sync/dynamic/douyin": ["./injectors/ext-shims/sync/dynamic/douyin.d.ts"],
      "@ext/sync/dynamic/weibo": ["./injectors/ext-shims/sync/dynamic/weibo.d.ts"],
      "@ext/sync/dynamic/zhihu": ["./injectors/ext-shims/sync/dynamic/zhihu.d.ts"],
      "@ext/sync/video/bilibili": ["./injectors/ext-shims/sync/video/bilibili.d.ts"],
      "@ext/sync/video/douyin": ["./injectors/ext-shims/sync/video/douyin.d.ts"],
      "@ext/sync/video/weibo": ["./injectors/ext-shims/sync/video/weibo.d.ts"],
      "@ext/sync/video/zhihu": ["./injectors/ext-shims/sync/video/zhihu.d.ts"],
      "@ext/*": ["../../../extension/src/*"],
      "~sync/*": ["../../../extension/src/sync/*"]
    }
  },
  "include": ["./**/*", "../shared/**/*"]
}
