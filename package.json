{
  "name": "multipost",
  "version": "2.0.3",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter multipost-web dev",
    "build": "pnpm --filter multipost-web build",
    "postinstall": "pnpm --filter multipost-web exec fumadocs-mdx",
    "start": "pnpm --filter multipost-web start",
    "lint": "pnpm --filter multipost-web lint",
    "lint:fix": "pnpm --filter multipost-web run lint:fix",
    "db:build:source": "bash db/scripts/atlas-build-source.sh",
    "db:diff": "pnpm db:build:source && atlas migrate diff --env local --config file://db/atlas/atlas.hcl",
    "db:apply": "atlas migrate apply --env production --config file://db/atlas/atlas.hcl",
    "db:lint": "pnpm db:build:source && atlas migrate lint --env local --config file://db/atlas/atlas.hcl --latest=1 && sh db/scripts/lint-atlas-no-dml.sh",
    "db:lint:no-dml": "sh db/scripts/lint-atlas-no-dml.sh",
    "db:studio": "drizzle-kit studio --config=db/drizzle.config.ts",
    "test:credit": "pnpm --filter multipost-web exec tsx scripts/credit-r2.6.test.ts",
    "test:data-migration": "tsx scripts/data-migrations/authjs-to-betterauth.fixture.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "decimal.js": "^10.5.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^20.17.25",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "czg": "^1.11.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "standard-version": "^9.5.0",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "@tsparticles/engine",
      "better-sqlite3",
      "core-js",
      "core-js-pure",
      "electron",
      "esbuild",
      "sharp"
    ]
  }
}
