generator client {
  provider      = "prisma-client-js"
  output        = "./client_multipost"
  binaryTargets = ["native", "darwin-arm64"]
}

generator denoclient {
  provider      = "prisma-client"
  output        = "../backend/prisma/client_multipost_deno"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  runtime       = "deno"
}

datasource db {
  provider = "postgresql"
  url      = env("MULTIPOST_DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  accounts           Account[]
  sessions           Session[]
  // Optional for WebAuthn support
  Authenticator      Authenticator[]
  SocialMediaAccount SocialMediaAccount[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Website             Website[]
  APIKey              APIKey[]
  ExtensionClient     ExtensionClient[]
  ExtensionTask       ExtensionTask[]
  Credit              Credit[]
  CreditUsage         CreditUsage[]
  RechargeCredit      RechargeCredit[]
  PromotionTask       PromotionTask[]
  PromotionCode       PromotionCode[]
  PromotionSubmission PromotionSubmission[]
  PlatformExtraConfig PlatformExtraConfig[]
  ImageGeneration     ImageGeneration[]
  PosterGeneration    PosterGeneration[]
  FileHosting         FileHosting[]
  Draft               Draft[]
  PublishTask         PublishTask[]
  PublishTaskLog      PublishTaskLog[]
  ImageGenerationLog  ImageGenerationLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Website {
  id        String    @id @unique @default(cuid())
  name      String    @db.VarChar(100)
  domain    String?   @db.VarChar(500)
  shareId   String?   @unique @db.VarChar(50)
  resetAt   DateTime?
  userId    String    @db.VarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventData   EventData[]
  sessionData SessionData[]
  User        User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([shareId])
}

model WebsiteEvent {
  id             String   @id() @default(uuid())
  websiteId      String
  sessionId      String
  visitId        String
  createdAt      DateTime @default(now())
  urlPath        String   @db.VarChar(500)
  urlQuery       String?  @db.VarChar(500)
  referrerPath   String?  @db.VarChar(500)
  referrerQuery  String?  @db.VarChar(500)
  referrerDomain String?  @db.VarChar(500)
  pageTitle      String?  @db.VarChar(500)
  eventType      Int      @default(1) @db.Integer
  eventName      String?  @db.VarChar(50)
  tag            String?  @db.VarChar(50)

  eventData EventData[]
  session   VisitorSession @relation(fields: [sessionId], references: [id])

  @@index([createdAt])
  @@index([sessionId])
  @@index([visitId])
  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@index([websiteId, createdAt, urlPath])
  @@index([websiteId, createdAt, urlQuery])
  @@index([websiteId, createdAt, referrerDomain])
  @@index([websiteId, createdAt, pageTitle])
  @@index([websiteId, createdAt, eventName])
  @@index([websiteId, createdAt, tag])
  @@index([websiteId, sessionId, createdAt])
  @@index([websiteId, visitId, createdAt])
}

model EventData {
  id             String    @id() @default(uuid())
  websiteId      String
  websiteEventId String
  dataKey        String
  stringValue    String?   @db.VarChar(500)
  numberValue    Decimal?  @db.Decimal(19, 4)
  dateValue      DateTime?
  dataType       Int       @db.Integer
  createdAt      DateTime  @default(now())

  website      Website      @relation(fields: [websiteId], references: [id])
  websiteEvent WebsiteEvent @relation(fields: [websiteEventId], references: [id])

  @@index([createdAt])
  @@index([websiteId])
  @@index([websiteEventId])
  @@index([websiteId, createdAt])
  @@index([websiteId, createdAt, dataKey])
}

model VisitorSession {
  id           String   @id @unique @default(uuid())
  websiteId    String
  hostname     String?  @db.VarChar(100)
  browser      String?  @db.VarChar(20)
  os           String?  @db.VarChar(20)
  device       String?  @db.VarChar(20)
  screen       String?  @db.VarChar(11)
  language     String?  @db.VarChar(35)
  country      String?  @db.Char(2)
  subdivision1 String?  @db.VarChar(20)
  subdivision2 String?  @db.VarChar(50)
  city         String?  @db.VarChar(50)
  ip           String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  websiteEvent WebsiteEvent[]
  sessionData  SessionData[]

  @@index([createdAt])
  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@index([websiteId, createdAt, hostname])
  @@index([websiteId, createdAt, browser])
  @@index([websiteId, createdAt, os])
  @@index([websiteId, createdAt, device])
  @@index([websiteId, createdAt, screen])
  @@index([websiteId, createdAt, language])
  @@index([websiteId, createdAt, country])
  @@index([websiteId, createdAt, subdivision1])
  @@index([websiteId, createdAt, city])
}

model SessionData {
  id          String    @id() @default(uuid())
  websiteId   String
  sessionId   String
  dataKey     String
  stringValue String?   @db.VarChar(500)
  numberValue Decimal?  @db.Decimal(19, 4)
  dateValue   DateTime?
  dataType    Int       @db.Integer
  createdAt   DateTime  @default(now())

  website Website        @relation(fields: [websiteId], references: [id])
  session VisitorSession @relation(fields: [sessionId], references: [id])

  @@index([createdAt])
  @@index([websiteId])
  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([websiteId, createdAt, dataKey])
}

model APIKey {
  id        String   @id @unique @default(cuid())
  userId    String
  name      String
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExtensionClient {
  id               String    @id @unique @default(cuid())
  userId           String
  name             String
  extensionVersion String    @default("unknown")
  platformInfos    Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ExtensionTask ExtensionTask[]
}

model ExtensionTask {
  id             String   @id @unique @default(cuid())
  userId         String
  taskType       String
  taskData       Json
  status         String
  targetClientId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetClient ExtensionClient @relation(fields: [targetClientId], references: [id], onDelete: Cascade)
}

model Credit {
  userId      String   @unique
  credits     Decimal  @db.Decimal(38, 18)
  freeCredits Decimal  @db.Decimal(38, 18)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditUsage {
  id        String   @id @unique @default(cuid())
  userId    String
  type      String
  amount    Decimal  @db.Decimal(38, 18)
  isFree    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RechargeCredit {
  id        String   @id @unique @default(cuid())
  userId    String
  orderId   String   @unique
  type      String
  amount    Decimal  @db.Decimal(38, 18)
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromotionTask {
  id          String   @id @unique @default(cuid())
  userId      String
  taskType    String
  title       String
  description String?
  link        String?
  keywords    String[]
  examples    String[]
  expiredAt   DateTime
  reward      Decimal  @default(0) @db.Decimal(38, 18)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  promotionCodes       PromotionCode[]
  promotionSubmissions PromotionSubmission[]
}

model PromotionCode {
  id        String   @id @unique @default(cuid())
  taskId    String
  code      String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task PromotionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, code])
}

model PromotionSubmission {
  id           String   @id @unique @default(cuid())
  taskId       String
  userId       String
  link         String
  scrapedData  Json
  verifiedData Json
  status       String
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task PromotionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model PlatformExtraConfig {
  id        String   @id @unique @default(cuid())
  userId    String
  platform  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model ImageGeneration {
  id          String   @id @unique @default(cuid())
  userId      String
  prompt      String
  extraPrompt String?
  images      Json?
  mask        Json?
  number      Int      @default(1)
  size        String   @default("auto")
  quality     String   @default("auto")
  background  String   @default("auto")
  status      String   @default("pending")
  message     String?
  workflowId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ImageGenerationLog ImageGenerationLog[]
}

model ImageGenerationLog {
  id                String   @id @unique @default(cuid())
  userId            String
  imageGenerationId String
  error             String?
  response          Json?
  url               String?
  fileHostingId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageGeneration ImageGeneration? @relation(fields: [imageGenerationId], references: [id], onDelete: Cascade)
  fileHosting     FileHosting?     @relation(fields: [fileHostingId], references: [id], onDelete: Cascade)
}

model PosterGeneration {
  id            String   @id @unique @default(cuid())
  userId        String
  prompt        String
  width         Int      @default(1080)
  height        Int      @default(1480)
  model         String   @default("deepseek-v3")
  status        String   @default("pending")
  systemPrompt  String?
  taskId        String?
  projectId     String?
  urls          Json?
  error         String?
  lastImageUrl  String?
  fileHostingId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileHosting FileHosting? @relation(fields: [fileHostingId], references: [id], onDelete: Cascade)
}

model FileHosting {
  id         String    @id @unique @default(cuid())
  userId     String
  key        String
  type       String?
  size       Int       @default(0)
  times      Int       @default(0)
  filename   String?
  previewUrl String?
  source     String?
  expiredAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  posterGeneration   PosterGeneration[]
  ImageGenerationLog ImageGenerationLog[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Draft {
  id        String   @id @unique @default(cuid())
  userId    String
  title     String?
  content   String?
  files     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  PublishTask PublishTask[]

  @@index([userId])
  @@index([createdAt])
}

model SocialMediaAccount {
  id           String    @id @unique @default(cuid())
  userId       String
  platform     String // twitter, facebook, instagram, linkedin, tiktok, etc.
  platformId   String // Platform-specific user ID
  avatarUrl    String?
  description  String?
  username     String? // Platform username/handle
  displayName  String? // Display name on the platform
  accessToken  String // OAuth access token
  refreshToken String? // OAuth refresh token (if available)
  tokenType    String    @default("Bearer") // Token type (usually Bearer)
  scope        String? // Granted permissions scope
  expiresAt    DateTime? // Token expiration time
  isActive     Boolean   @default(true) // Whether the account is active
  metadata     Json? // Additional platform-specific data
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, platformId])
  @@index([userId])
  @@index([platform])
  @@index([expiresAt])
}

model PublishTask {
  id          String   @id @unique @default(cuid())
  userId      String
  draftId     String
  publishedAt DateTime // 规划发布时间
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  draft          Draft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  PublishTaskLog PublishTaskLog[]
  User           User             @relation(fields: [userId], references: [id])
}

model PublishTaskLog {
  id            String    @id @unique @default(cuid())
  publishTaskId String
  userId        String
  platform      String
  platformId    String
  publishedAt   DateTime? // 实际发布时间
  status        String    @default("pending")
  publishData   Json?
  result        Json?
  error         String?
  message       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  publishTask PublishTask @relation(fields: [publishTaskId], references: [id], onDelete: Cascade)
  User        User        @relation(fields: [userId], references: [id])
}
