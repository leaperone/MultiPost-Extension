# Database Connection
MULTIPOST_DATABASE_URL=postgresql://user:password@localhost:5432/multipost_db

# Video Extraction API (TikHub)
VIDEO_EXTRACT_API_URL=https://api.tikhub.io/api/v1/hybrid/video_data
VIDEO_EXTRACT_API_KEY=your_tikhub_api_key_here

# STT (Speech-to-Text) API (borgcloud)
STT_API_URL=https://borgcloud.org/api/v1/audio/transcriptions
STT_API_KEY=your_stt_api_key_here
